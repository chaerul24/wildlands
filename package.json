{
  "name": "wildlands-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wildlands 3D Multiplayer Browser Game",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build && npx cap sync android && cd android && export ANDROID_HOME=/opt/android-sdk && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../client/dist/wildlands.apk",
    "start": "node server/src/index.js",
    "test": "npm run test:rpg && npm run test:swords && npm run test:npc && npm run test:multiplayer && npm run test:perf && npm run test:char && npm run test:orientation && npm run test:browser && npm run test:assets && npm run test:opening && npm run test:offline",
    "test:char": "node test/characterMainProtection.test.js",
    "test:rpg": "node test/rpgVerticalSlice.test.js",
    "test:swords": "node test/swordsAndMap.test.js",
    "test:npc": "node test/npcDialogueAndShops.test.js",
    "test:multiplayer": "node test/multiPlayerSimulation.js",
    "test:perf": "node test/performanceAndCamera.test.js",
    "test:orientation": "node test/orientationTransition.test.js",
    "test:browser": "node test/browserShopAndDialogue.test.js",
    "test:assets": "node test/assetValidation.test.js",
    "test:opening": "node test/gameOpeningAndAudio.test.js",
    "test:offline": "node test/offlineFirstCapabilities.test.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.14.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "socket.io-client": "^4.7.5"
  }
}
