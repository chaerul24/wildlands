{
  "name": "wildlands-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wildlands 3D Multiplayer Browser Game",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test:multiplayer": "node test/multiPlayerSimulation.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "socket.io-client": "^4.7.5"
  }
}
